# === Minimal .gitignore — only true junk / regenerable caches / secrets ===
# Everything else (submission/, companion/, meta/) IS tracked in the repo.

# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Secrets / env
.env
*.env
**/.env
*token*
*credentials*
*secret*

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Regenerable model / cache dirs (large, not source)
**/.cache/
**/.venv/
.venvs/
**/hf_cache/
**/torch_cache/

# Logs
*.log

# === Explicitly NOT ignored (tracked) ===
# submission/   — MIDC source (paper + code + results)
# companion/    — MIBE companion-paper data
# meta/         — working docs, refs, human-eval tarballs, external reference clones
