# === Minimal .gitignore — only true junk / regenerable caches / secrets ===
# Everything else (submission/, companion/, meta/) IS tracked in the repo.

# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Secrets / env
.env
*.env
**/.env
*token*
*credentials*
*secret*

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Regenerable model / cache dirs (large, not source)
**/.cache/
**/.venv/
.venvs/
**/hf_cache/
**/torch_cache/

# LaTeX build artifacts (main.tex + main.pdf are tracked; these are regenerable)
*.aux
*.bbl
*.blg
*.out
*.toc
*.synctex.gz

# Logs
*.log

# === Explicitly NOT ignored (tracked) ===
# submission/   — MIDC source (paper + code + results)
# companion/    — MIBE companion-paper data
# meta/         — working docs, refs, human-eval tarballs, external reference clones

# LaTeX build artifacts (main.log embeds absolute paths -> anonymity leak)
submission/paper/*.aux
submission/paper/*.log
submission/paper/*.out
submission/paper/*.bbl
submission/paper/*.blg
submission/paper/*.synctex.gz
submission/paper/*.fdb_latexmk
submission/paper/*.fls

# Extracted copy of Gold Set results — the same data already lives on the
# feat/neurips-lens branch (Evaluation_Pipeline/paper_data/). The zip beside it
# is committed for sharing; re-extract with `unzip mie_goldset_results.zip`.
companion/MIBE Rebuttal/mie_goldset_results/
