\@writefile{toc}{\contentsline {paragraph}{Failure Rates Increase with Subject Count.}{17}{section*.35}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces \textbf  {Failure Rates Increase with Subject Count} A representative 6-subject, 2-object prompt (ID: 6905) evaluated across four generative models. All models exhibit Existence failures, with subject omission ranging from 1 missing subject (FLUX2, Seedrems-4.5, GPT) to 3 missing subjects (GLM).}}{17}{figure.caption.36}\protected@file@percent }
\newlabel{fig:appendix-failure-rates-subject-count}{{8}{17}{\textbf {Failure Rates Increase with Subject Count} A representative 6-subject, 2-object prompt (ID: 6905) evaluated across four generative models. All models exhibit Existence failures, with subject omission ranging from 1 missing subject (FLUX2, Seedrems-4.5, GPT) to 3 missing subjects (GLM)}{figure.caption.36}{}}
\def\@LN@column{1}
\@writefile{toc}{\contentsline {paragraph}{Existence Failures Frequently Co-occur with Appearance Failures.}{18}{section*.37}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces \textbf  {Existence Failures Frequently Co-occur with Appearance Failures} A representative 4-subject prompt (ID: 32062) generated by Seedream, the best-performing model on this sample. The missing subject (Man in Black Suit) is not simply absent: its visual attributes --- the black tie and formal shirt --- are redistributed onto the surviving Bomber Jacket figure, producing a hybrid identity.}}{18}{figure.caption.38}\protected@file@percent }
\newlabel{fig:appendix-existence-appearance-cooccurrence}{{9}{18}{\textbf {Existence Failures Frequently Co-occur with Appearance Failures} A representative 4-subject prompt (ID: 32062) generated by Seedream, the best-performing model on this sample. The missing subject (Man in Black Suit) is not simply absent: its visual attributes --- the black tie and formal shirt --- are redistributed onto the surviving Bomber Jacket figure, producing a hybrid identity}{figure.caption.38}{}}
\@writefile{toc}{\contentsline {paragraph}{Multi-Action Overload Leads to Subject Deformation}{18}{section*.39}\protected@file@percent }
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces \textbf  {Multi-Action Overload Leads to Subject Deformation.} When a subject is assigned more than one concurrent action, models either clone the subject to satisfy each action independently (Figure Splitting, ID: 61186) or silently discard one of the assigned actions (Action Dropout, ID: 60869). Both failure modes are observed in Nano Banana, a better performing model in these cases.}}{19}{figure.caption.40}\protected@file@percent }
\newlabel{fig:appendix-multi-action-overload}{{10}{19}{\textbf {Multi-Action Overload Leads to Subject Deformation.} When a subject is assigned more than one concurrent action, models either clone the subject to satisfy each action independently (Figure Splitting, ID: 61186) or silently discard one of the assigned actions (Action Dropout, ID: 60869). Both failure modes are observed in Nano Banana, a better performing model in these cases}{figure.caption.40}{}}
